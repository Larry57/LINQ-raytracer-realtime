<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RayTracerGpu</RootNamespace>
    <AssemblyName>RayTracerGpu</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="7.0.1" />
  </ItemGroup>

  <!-- Le ray tracer GPU vit entièrement dans le fragment shader : on réutilise
       tel quel celui de la version C, copié à côté de l'exécutable. -->
  <ItemGroup>
    <None Include="../c/shader.fs" Link="shader.fs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
